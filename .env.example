# Google Analytics 4 Configuration
# Înlocuiește 'G-XXXXXXXXXX' cu Measurement ID-ul tău real din Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google OAuth 2.0 Configuration (pentru conectarea automată)
# Obține aceste credentiale din Google Cloud Console (console.cloud.google.com)
# 1. Creează un proiect sau selectează unul existent
# 2. Activează Google Analytics Reporting API
# 3. Mergi la Credentials > Create Credentials > OAuth 2.0 Client IDs
# 4. Selectează "Web application" și configurează Authorized redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/analytics/google/callback

# Cum să obții Measurement ID-ul GA4:
# 1. Accesează Google Analytics (analytics.google.com)
# 2. Selectează proprietatea ta
# 3. Mergi la Admin > Data Streams > Web stream
# 4. Click pe stream-ul tău
# 5. Găsești Measurement ID-ul (în format G-XXXXXXXXXX)